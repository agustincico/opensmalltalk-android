# Release signing — copy this file to app/keystore.properties and fill it in.
# app/keystore.properties and *.jks are gitignored: NEVER commit real credentials.
#
# Create a keystore with:
#   keytool -genkey -v -keystore my-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias myAlias
#
# You do NOT need any of this to build/run the app: `./gradlew assembleDebug`
# (what scripts/loop/build.sh uses) signs with the standard debug key.
# Without this file, `assembleRelease` still builds — the APK is just unsigned.

storeFile=my-release.jks
storePassword=CHANGEME
keyAlias=myAlias
keyPassword=CHANGEME
